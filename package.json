{
  "name": "dispomvp",
  "version": "1.0.0",
  "private": true,
  "description": "DispoMVP resource planning - REST API (Express + Postgres)",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "node server/migrate.js",
    "test": "node --test --test-concurrency=1 \"server/test/*.test.js\"",
    "lint": "eslint server --max-warnings 0"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "2.8.6",
    "express": "4.22.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "supertest": "7.3.1"
  }
}
