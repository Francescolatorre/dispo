# Copy to .env.local to override (not committed).
# Where planning data lives:
#   auto  (default) - use the API at /api if GET /api/health answers, else the browser (localStorage)
#   api             - always the API (the Vite dev server proxies /api to http://localhost:3001)
#   local           - always the browser (localStorage), no server needed
VITE_DATA_SOURCE=auto
