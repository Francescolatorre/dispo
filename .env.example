# Copy to .env and adjust. Values below match docker-compose.yml.

# Host port the Postgres container is published on (docker-compose.yml).
DB_HOST_PORT=5433

DATABASE_URL=postgres://dispo:dispo@localhost:5433/dispo
TEST_DATABASE_URL=postgres://dispo:dispo@localhost:5433/dispo_test

PORT=3001
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
